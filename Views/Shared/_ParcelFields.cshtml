@model Parcel

@* The form fields Add and Edit share *@
<div class="mb-3">
    <label asp-for="TrackingCode" class="form-label"></label>
    <input asp-for="TrackingCode" class="form-control" />
    <span asp-validation-for="TrackingCode" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Recipient" class="form-label"></label>
    <input asp-for="Recipient" class="form-control" />
    <span asp-validation-for="Recipient" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="WeightKg" class="form-label"></label>
    <input asp-for="WeightKg" class="form-control" step="0.1" />
    <span asp-validation-for="WeightKg" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Status" class="form-label"></label>
    <select asp-for="Status" asp-items="ViewBag.Statuses" class="form-select"></select>
    <span asp-validation-for="Status" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="BranchId" class="form-label"></label>
    <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
        <option value="">Pick a branch</option>
    </select>
    <span asp-validation-for="BranchId" class="text-danger"></span>
</div>
